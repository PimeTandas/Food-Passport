# Caddy gets and renews a free HTTPS certificate from Let's Encrypt for SITE_DOMAIN automatically,
# redirects http -> https, and passes requests to the Spring app.
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# The health check is for the server itself, not the internet.
	respond /actuator/* 404

	reverse_proxy app:8080
}

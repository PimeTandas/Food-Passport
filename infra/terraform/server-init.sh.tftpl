#!/bin/bash
# First boot of the server (EC2 "user data"). Installs Docker, writes the settings file and the
# deploy/backup helpers. The app itself arrives with the first GitHub Actions deploy.
# Note: this is a Terraform template. Values like the region are filled in by Terraform; plain $VAR is shell.
set -euxo pipefail

# 1 GB of RAM is tight for Java + PostgreSQL: add 1 GB of swap as a safety net.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap defaults 0 0' >> /etc/fstab
fi

# Docker + the compose plugin
dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# Non-secret settings for the deploy and backup scripts
mkdir -p /opt/foodpassport/bundle
cat > /opt/foodpassport/host.env <<'ENV'
AWS_REGION=${region}
ECR_REPOSITORY_URL=${ecr_repository_url}
PHOTOS_BUCKET=${photos_bucket}
OPS_BUCKET=${ops_bucket}
PARAM_PREFIX=${param_prefix}
SITE_DOMAIN=${site_domain}
ACME_EMAIL=${acme_email}
ENV
chmod 600 /opt/foodpassport/host.env

# GitHub Actions calls this through AWS Systems Manager: fetch the latest deploy files, run deploy.sh.
cat > /usr/local/bin/foodpassport-deploy <<'SH'
#!/bin/bash
set -euo pipefail
source /opt/foodpassport/host.env
aws s3 sync "s3://$OPS_BUCKET/deploy/" /opt/foodpassport/bundle/ --delete --exclude ".env" --region "$AWS_REGION"
chmod +x /opt/foodpassport/bundle/*.sh
exec /opt/foodpassport/bundle/deploy.sh "$@"
SH
chmod 700 /usr/local/bin/foodpassport-deploy

# Nightly database backup to S3 at ~03:30 UTC
cat > /etc/systemd/system/foodpassport-backup.service <<'UNIT'
[Unit]
Description=Back up the Food Passport database to S3
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/foodpassport/bundle/backup.sh
UNIT

cat > /etc/systemd/system/foodpassport-backup.timer <<'UNIT'
[Unit]
Description=Nightly Food Passport database backup

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now foodpassport-backup.timer
